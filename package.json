{
  "name": "dayzero-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform dark calendar and task planner for Electron and Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "electron:pack": "npm run build && electron-builder --win --publish never",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.3",
    "firebase": "^11.10.0",
    "lucide": "^0.468.0",
    "lucide-static": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "concurrently": "^9.2.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^6.4.1",
    "wait-on": "^8.0.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.dayzero.calendar",
    "productName": "DayZero Calendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "author": "DayZero"
}
